{
  "schemaVersion": 1,
  "id": "omaqbt.remote",
  "name": "OmaqBT",
  "version": "1.0.0",
  "author": "OmaqBT maintainers",
  "license": "MIT",
  "description": "OmaqBT: remotely control qBittorrent transfers through its Web API.",
  "kinds": ["bar-widget"],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "OmaqBT",
    "description": "Watch and control transfers on a local or remote qBittorrent Web API.",
    "category": "Network",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "baseUrl": "http://127.0.0.1:8080",
      "username": "",
      "refreshIntervalSec": 5
    },
    "schema": [
      {
        "key": "baseUrl",
        "type": "string",
        "label": "qBittorrent Web API URL",
        "defaultValue": "http://127.0.0.1:8080"
      },
      {
        "key": "username",
        "type": "string",
        "label": "qBittorrent username",
        "defaultValue": ""
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Fallback refresh interval (seconds)",
        "min": 5,
        "max": 3600,
        "step": 5,
        "defaultValue": 5
      }
    ]
  }
}
