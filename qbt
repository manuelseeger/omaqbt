#!/usr/bin/env bash
set -euo pipefail
umask 077

if [[ -n ${XDG_RUNTIME_DIR:-} ]]; then
  STATE_DIR="${QBT_STATE_DIR:-$XDG_RUNTIME_DIR/omaqbt}"
else
  STATE_DIR="${QBT_STATE_DIR:-/tmp/omaqbt-$(id -u)}"
fi

sanitize() {
  sed -E \
    -e 's/(Set-Cookie:|Cookie:)[^\r\n]*/\1 <redacted>/gi' \
    -e 's/SID[=:][^;,&[:space:]"]*/SID=<redacted>/gi' \
    -e 's/((username|password|passwd|pwd)"?[[:space:]]*[:=][[:space:]]*"?)[^&;,"[:space:]]+/\1<redacted>/gi'
}

die() {
  printf '%s\n' "$*" | sanitize >&2
  exit 1
}

ensure_state_dir() {
  local dir=$1
  [[ -n $dir ]] || die "state directory is empty"
  if [[ -L $dir ]]; then
    die "refusing symlinked state dir: $dir"
  fi
  if [[ ! -d $dir ]]; then
    (umask 077; mkdir -p "$dir") || die "cannot create state dir: $dir"
  fi
  local owner
  owner=$(stat -c '%u' "$dir" 2>/dev/null || printf '')
  if [[ -n $owner && $owner != "$(id -u)" ]]; then
    die "state dir not owned by current user: $dir"
  fi
  chmod 700 "$dir" 2>/dev/null || die "cannot secure state dir: $dir"
}

ensure_private_file() {
  local file=$1
  if [[ -L $file ]]; then
    die "refusing symlinked state file: $file"
  fi
  if [[ -e $file ]]; then
    local owner
    owner=$(stat -c '%u' "$file" 2>/dev/null || printf '')
    if [[ -n $owner && $owner != "$(id -u)" ]]; then
      die "state file not owned by current user: $file"
    fi
  else
    : >"$file"
  fi
  chmod 600 "$file" 2>/dev/null || die "cannot secure state file: $file"
}

BASE_INPUT="${QBT_BASE:-http://127.0.0.1:8080}"
USERNAME="${QBT_USERNAME:-}"
while [[ ${1:-} == --* ]]; do
  case $1 in
    --base-url)
      [[ $# -ge 2 ]] || die "--base-url needs a value"
      BASE_INPUT=$2
      shift 2
      ;;
    --username)
      [[ $# -ge 2 ]] || die "--username needs a value"
      USERNAME=$2
      shift 2
      ;;
    --)
      shift
      break
      ;;
    *) die "unknown global option: $1" ;;
  esac
done

validation=""
if ! validation=$(python3 - "$BASE_INPUT" <<'PY'
import sys
import unicodedata
from urllib.parse import urlsplit, urlunsplit

raw = sys.argv[1]
if not raw:
    raise SystemExit("the URL is empty")
if any(ord(ch) < 32 or 127 <= ord(ch) <= 159 or unicodedata.category(ch) == "Cf" for ch in raw):
    raise SystemExit("control characters are not allowed")
if "?" in raw:
    raise SystemExit("query strings are not allowed")
if "#" in raw:
    raise SystemExit("fragments are not allowed")
try:
    parsed = urlsplit(raw)
    port = parsed.port
except ValueError:
    raise SystemExit("the host or port is invalid")
scheme = parsed.scheme.lower()
if scheme not in ("http", "https"):
    raise SystemExit("only http and https are supported")
if parsed.username is not None or parsed.password is not None or "@" in parsed.netloc:
    raise SystemExit("userinfo is not allowed")
host = parsed.hostname
if not host or any(ch.isspace() for ch in host):
    raise SystemExit("the host is empty or invalid")
host = host.lower()
if scheme == "http" and host not in ("127.0.0.1", "localhost", "::1"):
    raise SystemExit("plain HTTP is allowed only for loopback endpoints")
netloc = f"[{host}]" if ":" in host else host
if port is not None:
    netloc += f":{port}"
path = parsed.path.rstrip("/")
print(urlunsplit((scheme, netloc, path, "", "")))
PY
); then
  die "invalid base URL: $validation"
fi
BASE_URL=$validation

read -r CONNECTION_KEY _ < <(printf '%s\0%s' "$BASE_URL" "$USERNAME" | sha256sum)
CONNECTIONS_DIR="$STATE_DIR/connections"
CONNECTION_DIR="$CONNECTIONS_DIR/$CONNECTION_KEY"
COOKIE_FILE="$CONNECTION_DIR/cookies.txt"
RID_FILE="$CONNECTION_DIR/rid.json"
ensure_state_dir "$STATE_DIR"
ensure_state_dir "$CONNECTIONS_DIR"
ensure_state_dir "$CONNECTION_DIR"
ensure_private_file "$COOKIE_FILE"
ensure_private_file "$RID_FILE"

API_ERROR=""
HTTP_CODE=""
HTTP_BODY_FILE=""

cleanup_response() {
  if [[ -n ${HTTP_BODY_FILE:-} ]]; then
    rm -f "$HTTP_BODY_FILE"
    HTTP_BODY_FILE=""
  fi
}

curl_once() {
  local method=$1 path=$2 timeout=$3
  shift 3
  cleanup_response
  HTTP_BODY_FILE=$(mktemp "$CONNECTION_DIR/response.XXXXXX")
  local code_file error_file curl_status curl_detail
  code_file=$(mktemp "$CONNECTION_DIR/code.XXXXXX")
  error_file=$(mktemp "$CONNECTION_DIR/curl-error.XXXXXX")
  set +e
  curl -sS -g --max-time "$timeout" \
    -X "$method" \
    -b "$COOKIE_FILE" -c "$COOKIE_FILE" \
    -H "Referer: $BASE_URL/" \
    -o "$HTTP_BODY_FILE" -w '%{http_code}' \
    "$BASE_URL$path" "$@" >"$code_file" 2>"$error_file"
  curl_status=$?
  set -e
  HTTP_CODE=$(<"$code_file")
  curl_detail=$(sanitize <"$error_file")
  curl_detail=${curl_detail:0:300}
  rm -f "$code_file" "$error_file"
  if [[ $curl_status -ne 0 ]]; then
    API_ERROR="TLS or transport failure while contacting qBittorrent"
    [[ -n $curl_detail ]] && API_ERROR+=": $curl_detail"
    cleanup_response
    return 1
  fi
  return 0
}

has_session_cookie() {
  python3 - "$COOKIE_FILE" <<'PY'
import re
import sys
from pathlib import Path

try:
    lines = Path(sys.argv[1]).read_text(errors="replace").splitlines()
except OSError:
    raise SystemExit(1)
for line in lines:
    if line.startswith("#HttpOnly_"):
        line = line[len("#HttpOnly_"):]
    elif line.startswith("#"):
        continue
    fields = line.split("\t")
    if len(fields) >= 7 and re.search(r"(^|_)sid(_|$)", fields[-2], re.I) and fields[-1]:
        raise SystemExit(0)
raise SystemExit(1)
PY
}

authenticate() {
  if [[ -z $USERNAME ]]; then
    API_ERROR="authentication required but no username is configured"
    return 1
  fi
  if ! command -v secret-tool >/dev/null 2>&1; then
    API_ERROR="authentication requires secret-tool (libsecret)"
    return 1
  fi

  local coproc_fd secret_fd secret_pid secret_status
  coproc OMAQBT_SECRET_LOOKUP {
    secret-tool lookup \
      application omaqbt.remote \
      endpoint "$BASE_URL" \
      username "$USERNAME" 2>/dev/null
  }
  coproc_fd=${OMAQBT_SECRET_LOOKUP[0]}
  exec {secret_fd}<&"$coproc_fd"
  secret_pid=$OMAQBT_SECRET_LOOKUP_PID
  set +e
  wait "$secret_pid"
  secret_status=$?
  set -e
  if [[ $secret_status -ne 0 ]]; then
    exec {secret_fd}<&-
    API_ERROR="no Secret Service password exists for this endpoint and username"
    return 1
  fi

  cleanup_response
  HTTP_BODY_FILE=$(mktemp "$CONNECTION_DIR/login-response.XXXXXX")
  local code_file error_file curl_status curl_detail
  code_file=$(mktemp "$CONNECTION_DIR/login-code.XXXXXX")
  error_file=$(mktemp "$CONNECTION_DIR/login-error.XXXXXX")
  set +e
  curl -sS -g --max-time 15 \
    -X POST \
    -b "$COOKIE_FILE" -c "$COOKIE_FILE" \
    -H "Referer: $BASE_URL/" \
    --data-urlencode "username=$USERNAME" \
    --data-urlencode 'password@-' \
    -o "$HTTP_BODY_FILE" -w '%{http_code}' \
    "$BASE_URL/api/v2/auth/login" \
    <&"$secret_fd" >"$code_file" 2>"$error_file"
  curl_status=$?
  set -e
  exec {secret_fd}<&-
  HTTP_CODE=$(<"$code_file")
  curl_detail=$(sanitize <"$error_file")
  curl_detail=${curl_detail:0:300}
  rm -f "$code_file" "$error_file"

  if [[ $curl_status -ne 0 ]]; then
    API_ERROR="TLS or transport failure while authenticating to qBittorrent"
    [[ -n $curl_detail ]] && API_ERROR+=": $curl_detail"
    cleanup_response
    return 1
  fi
  if [[ $HTTP_CODE == 403 ]]; then
    API_ERROR="qBittorrent reports that this client IP is banned after too many failed login attempts (HTTP 403)"
    cleanup_response
    return 1
  fi
  if [[ $HTTP_CODE != 200 && $HTTP_CODE != 204 ]]; then
    API_ERROR="qBittorrent login returned HTTP $HTTP_CODE"
    cleanup_response
    return 1
  fi

  local login_body
  login_body=$(<"$HTTP_BODY_FILE")
  cleanup_response
  if [[ $HTTP_CODE == 200 && $login_body != "Ok." ]]; then
    API_ERROR="qBittorrent rejected the stored credentials"
    return 1
  fi
  if ! has_session_cookie; then
    API_ERROR="qBittorrent login succeeded without returning a session cookie"
    return 1
  fi
  return 0
}

api_request() {
  local method=$1 path=$2 timeout=$3
  shift 3
  API_ERROR=""
  if ! curl_once "$method" "$path" "$timeout" "$@"; then
    return 1
  fi
  if [[ $HTTP_CODE == 403 ]]; then
    cleanup_response
    if ! authenticate; then
      return 1
    fi
    if ! curl_once "$method" "$path" "$timeout" "$@"; then
      return 1
    fi
    if [[ $HTTP_CODE == 403 ]]; then
      API_ERROR="authentication or proxy access was rejected after login (HTTP 403)"
      cleanup_response
      return 1
    fi
  fi
  if [[ $HTTP_CODE != 200 && $HTTP_CODE != 204 ]]; then
    local response
    response=$(sanitize <"$HTTP_BODY_FILE")
    response=${response:0:500}
    API_ERROR="qBittorrent API returned HTTP $HTTP_CODE"
    [[ -n $response ]] && API_ERROR+=": $response"
    cleanup_response
    return 1
  fi
  return 0
}

print_status_error() {
  local error
  error=$(printf '%s' "$1" | sanitize)
  jq -n --arg error "$error" \
    '{api:false,error:$error,altSpeed:false,dlSpeed:0,upSpeed:0,torrents:[]}'
}

cmd_status() {
  local rid=0
  if [[ -s $RID_FILE ]]; then
    if ! rid=$(jq -r '.rid // 0' "$RID_FILE" 2>/dev/null); then
      rid=0
      : >"$RID_FILE"
    fi
  fi

  if ! api_request GET "/api/v2/sync/maindata?rid=$rid" 5; then
    print_status_error "$API_ERROR"
    return 0
  fi
  local sync_response=$HTTP_BODY_FILE merged
  HTTP_BODY_FILE=""
  if ! merged=$(python3 - "$sync_response" "$RID_FILE" <<'PY'
import json
import os
import sys
from pathlib import Path

response_path = Path(sys.argv[1])
rid_path = Path(sys.argv[2])
raw = json.loads(response_path.read_text() or "{}")
cache = {}
if rid_path.exists() and rid_path.stat().st_size:
    try:
        cache = json.loads(rid_path.read_text() or "{}").get("torrents") or {}
    except (OSError, ValueError, TypeError):
        cache = {}
if raw.get("full_update"):
    torrents = dict(raw.get("torrents") or {})
else:
    torrents = dict(cache)
    for key, value in (raw.get("torrents") or {}).items():
        current = dict(torrents.get(key) or {})
        current.update(value or {})
        torrents[key] = current
    for key in raw.get("torrents_removed") or []:
        torrents.pop(key, None)

normalized = {}
for key, value in torrents.items():
    torrent = dict(value or {})
    info_hash = torrent.get("hash") or torrent.get("infohash_v1") or torrent.get("infohash_v2") or key
    torrent["hash"] = info_hash
    normalized[str(info_hash)] = torrent
torrents = normalized

rows = []
for key, torrent in torrents.items():
    rows.append({
        "hash": key,
        "name": torrent.get("name") or "",
        "state": torrent.get("state") or "",
        "progress": torrent.get("progress") or 0,
        "dlSpeed": torrent.get("dlspeed") if torrent.get("dlspeed") is not None else torrent.get("dlSpeed") or 0,
        "upSpeed": torrent.get("upspeed") if torrent.get("upspeed") is not None else torrent.get("upSpeed") or 0,
        "eta": torrent.get("eta") or 0,
        "ratio": torrent.get("ratio") or 0,
        "size": torrent.get("size") or 0,
        "savePath": torrent.get("save_path") or "",
        "contentPath": torrent.get("content_path") or "",
        "numSeeds": torrent.get("num_seeds") or 0,
        "numLeechs": torrent.get("num_leechs") or 0,
        "addedOn": torrent.get("added_on") or 0,
        "dlLimit": torrent.get("dl_limit") or 0,
        "upLimit": torrent.get("up_limit") or 0,
        "seqDl": torrent.get("seq_dl") is True,
        "ratioLimit": -2 if torrent.get("ratio_limit") is None else torrent.get("ratio_limit"),
    })

state = {"rid": raw.get("rid") or 0, "torrents": torrents}
tmp = rid_path.with_name(f".{rid_path.name}.{os.getpid()}.tmp")
with tmp.open("x") as handle:
    json.dump(state, handle, separators=(",", ":"))
os.chmod(tmp, 0o600)
os.replace(tmp, rid_path)
server = raw.get("server_state") or {}
print(json.dumps({
    "dlSpeed": server.get("dl_info_speed") or 0,
    "upSpeed": server.get("up_info_speed") or 0,
    "torrents": rows,
}, separators=(",", ":")))
PY
  ); then
    rm -f "$sync_response"
    print_status_error "qBittorrent returned an invalid sync response"
    return 0
  fi
  rm -f "$sync_response"

  local alt_speed=false
  if api_request GET "/api/v2/transfer/speedLimitsMode" 5; then
    [[ $(<"$HTTP_BODY_FILE") == 1 ]] && alt_speed=true
    cleanup_response
  fi
  printf '%s' "$merged" | jq --argjson altSpeed "$alt_speed" \
    '{api:true,error:"",altSpeed:$altSpeed,dlSpeed:(.dlSpeed // 0),upSpeed:(.upSpeed // 0),torrents:(.torrents // [])}'
}

require_api() {
  if ! api_request "$@"; then
    die "$API_ERROR"
  fi
}

cmd_add() {
  local stopped=false savepath="" category="" target=""
  while [[ $# -gt 0 ]]; do
    case $1 in
      --stopped) stopped=true; shift ;;
      --savepath) [[ $# -ge 2 ]] || die "--savepath needs a value"; savepath=$2; shift 2 ;;
      --category) [[ $# -ge 2 ]] || die "--category needs a value"; category=$2; shift 2 ;;
      *) target=$1; shift ;;
    esac
  done
  [[ -n $target ]] || die "usage: qbt add [--stopped] [--savepath <dir>] [--category <name>] <magnet, .torrent URL, or .torrent file>"
  local path=$target
  [[ $path == file://* ]] && path=${path#file://}
  [[ $path == "~/"* ]] && path=$HOME/${path#\~/}
  local args=()
  if [[ $path == /* ]]; then
    [[ -f $path ]] || die "no such torrent file: $path"
    args=(-F "torrents=@${path}")
    [[ $stopped == true ]] && args+=(-F "stopped=true" -F "paused=true")
    [[ -n $savepath ]] && args+=(-F "savepath=${savepath}")
    [[ -n $category ]] && args+=(-F "category=${category}")
  else
    args=(-H "Content-Type: application/x-www-form-urlencoded" --data-urlencode "urls=$target")
    [[ $stopped == true ]] && args+=(--data-urlencode "stopped=true" --data-urlencode "paused=true")
    [[ -n $savepath ]] && args+=(--data-urlencode "savepath=$savepath")
    [[ -n $category ]] && args+=(--data-urlencode "category=$category")
  fi
  require_api POST "/api/v2/torrents/add" 30 "${args[@]}"
  cleanup_response
  printf '%s\n' '{"ok":true}'
}

cmd_start() {
  local hash=${1:-}
  [[ -n $hash ]] || die "usage: qbt start <hash|all>"
  require_api POST "/api/v2/torrents/start" 15 --data-urlencode "hashes=$hash"
  cleanup_response
  printf '%s\n' '{"ok":true}'
}

cmd_stop() {
  local hash=${1:-}
  [[ -n $hash ]] || die "usage: qbt stop <hash|all>"
  require_api POST "/api/v2/torrents/stop" 15 --data-urlencode "hashes=$hash"
  cleanup_response
  printf '%s\n' '{"ok":true}'
}

cmd_delete() {
  local hash=${1:-} files=false
  shift || true
  [[ ${1:-} == --files ]] && files=true
  [[ -n $hash ]] || die "usage: qbt delete <hash> [--files]"
  require_api POST "/api/v2/torrents/delete" 15 \
    --data-urlencode "hashes=$hash" --data-urlencode "deleteFiles=$files"
  cleanup_response
  printf '%s\n' '{"ok":true}'
}

cmd_turtle() {
  require_api POST "/api/v2/transfer/toggleSpeedLimitsMode" 15
  cleanup_response
  printf '%s\n' '{"ok":true}'
}

cmd_limit() {
  local hash=${1:-} kind=${2:-} bytes=${3:-}
  [[ -n $hash && -n $bytes && ( $kind == dl || $kind == up ) ]] || die "usage: qbt limit <hash|all> <dl|up> <bytes-per-sec, 0 = unlimited>"
  local endpoint=setDownloadLimit
  [[ $kind == up ]] && endpoint=setUploadLimit
  require_api POST "/api/v2/torrents/$endpoint" 15 \
    --data-urlencode "hashes=$hash" --data-urlencode "limit=$bytes"
  cleanup_response
  printf '%s\n' '{"ok":true}'
}

cmd_sequential() {
  local hash=${1:-}
  [[ -n $hash ]] || die "usage: qbt sequential <hash>"
  require_api POST "/api/v2/torrents/toggleSequentialDownload" 15 --data-urlencode "hashes=$hash"
  cleanup_response
  printf '%s\n' '{"ok":true}'
}

cmd_sharelimit() {
  local hash=${1:-} ratio=${2:-}
  [[ -n $hash && -n $ratio ]] || die "usage: qbt sharelimit <hash> <ratio, -2 = global, -1 = none>"
  require_api POST "/api/v2/torrents/setShareLimits" 15 \
    --data-urlencode "hashes=$hash" \
    --data-urlencode "ratioLimit=$ratio" \
    --data-urlencode "seedingTimeLimit=-2" \
    --data-urlencode "inactiveSeedingTimeLimit=-2"
  cleanup_response
  printf '%s\n' '{"ok":true}'
}

cmd_files() {
  local hash=${1:-}
  [[ -n $hash ]] || die "usage: qbt files <hash>"
  require_api GET "/api/v2/torrents/files?hash=$hash" 15
  cat "$HTTP_BODY_FILE"
  printf '\n'
  cleanup_response
}

cmd_prio() {
  local hash=${1:-} index=${2:-} prio=${3:-}
  [[ -n $hash && -n $index && -n $prio ]] || die "usage: qbt prio <hash> <index> <0|1|6|7>"
  require_api POST "/api/v2/torrents/filePrio" 15 \
    --data-urlencode "hash=$hash" --data-urlencode "id=$index" --data-urlencode "priority=$prio"
  cleanup_response
  printf '%s\n' '{"ok":true}'
}

command_name=${1:-}
shift || true
case $command_name in
  status) cmd_status "$@" ;;
  add) cmd_add "$@" ;;
  start) cmd_start "$@" ;;
  stop) cmd_stop "$@" ;;
  delete) cmd_delete "$@" ;;
  files) cmd_files "$@" ;;
  prio) cmd_prio "$@" ;;
  turtle) cmd_turtle "$@" ;;
  limit) cmd_limit "$@" ;;
  sequential) cmd_sequential "$@" ;;
  sharelimit) cmd_sharelimit "$@" ;;
  *) die "usage: qbt [--base-url <url>] [--username <name>] status|add|start|stop|delete|files|prio|turtle|limit|sequential|sharelimit" ;;
esac
